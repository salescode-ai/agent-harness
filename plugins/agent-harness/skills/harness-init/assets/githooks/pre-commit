#!/usr/bin/env bash
# agent-harness git hook: runs the repo's check-fast gate. Skips only while the gate isn't wired yet; a gate that
# can't be resolved (broken Makefile) fails the commit. SKIP_HOOKS=1 skips it (people only: the Bash guard refuses
# it for agents). HARNESS_HOOK_STAGED_ONLY=1 tests the staged snapshot instead of the working tree.
[ "${SKIP_HOOKS:-}" = 1 ] && { echo "harness: SKIP_HOOKS=1, skipping pre-commit"; exit 0; }
# harness-init writes .harness/init-state.json first and sets "gate_wired": true last; skip until then
if [ -f .harness/init-state.json ] && ! grep -qE '"gate_wired"[[:space:]]*:[[:space:]]*true' .harness/init-state.json; then
  echo "harness: setup in progress, skipping"; exit 0
fi
# a plan closed as done (added under plans/done/, or a staged "Status: done") needs a fresh harness-verify PASS
closed="$( { git diff --cached --name-only --diff-filter=AR -- 'docs/plans/done/*.md' 'plans/done/*.md'
  git diff --cached --name-only --diff-filter=M -- 'docs/plans/*.md' 'plans/*.md' | while IFS= read -r f; do
    git diff --cached -U0 -- "$f" | grep -E '^\+.*Status\**:\**[[:space:]]*done' >/dev/null && echo "$f"; done; } \
  | grep -v '/TEMPLATE\.md$' | sort -u)"
if [ -n "$closed" ]; then
  if [ ! -d .harness/evidence ] && [ "${HARNESS_ALLOW_UNVERIFIED_DONE:-}" = 1 ]; then
    echo "harness: no .harness/evidence on this machine; closing plan(s) unverified (HARNESS_ALLOW_UNVERIFIED_DONE=1)"
  elif [ ! -f scripts/harness/plan-check.sh ]; then
    echo "harness: scripts/harness/plan-check.sh missing, plan freshness not checked; run /agent-harness:harness-upgrade"
  else
    while IFS= read -r f; do
      msg="$(bash scripts/harness/plan-check.sh fresh ".harness/evidence/$(basename "$f")" 2>&1)" && continue
      echo "harness: $f is closed as done without a fresh PASS: $msg" >&2
      echo "  Run harness-verify, commit the code, then close the plan in its own commit (plan-only commits stay fresh)." >&2
      exit 1
    done <<<"$closed"
  fi
fi
[ -f scripts/harness/cmd.sh ] || { echo "harness: scripts/harness/cmd.sh missing, skipping"; exit 0; }
cmd="$(bash scripts/harness/cmd.sh . check-fast)"; rc=$?
if [ $rc != 0 ]; then
  # nothing to resolve the gate from, and init never wired it: not set up yet
  if [ $rc = 3 ] && ! grep -qs '"gate_wired"[[:space:]]*:[[:space:]]*true' .harness/init-state.json \
    && [ ! -f Makefile ] && [ ! -f makefile ] && [ ! -f GNUmakefile ] && [ ! -f .agents/harness.json ]; then
    echo "harness: check-fast not wired, skipping"; exit 0
  fi
  echo "harness: cannot resolve the check-fast gate (scripts/harness/cmd.sh exit $rc):" >&2
  make -n check-fast 2>&1 >/dev/null | tail -5 | sed 's/^/  /' >&2
  echo "  Run make -n check-fast and fix the Makefile (or .agents/harness.json)." >&2
  exit 1
fi
dirty="$( { git diff --name-only; git ls-files --others --exclude-standard; } | grep -vE '^docs/|\.md$' | sort -u)"
[ -n "$dirty" ] || { eval "$cmd"; exit; }
if [ "${HARNESS_HOOK_STAGED_ONLY:-}" != 1 ]; then
  echo "harness: unstaged or untracked changes are part of this check ($(head -3 <<<"$dirty" | tr '\n' ' ' | sed 's/ $//')); HARNESS_HOOK_STAGED_ONLY=1 checks only what is staged" >&2
  eval "$cmd"; exit
fi
# the staged snapshot in a scratch worktree (git write-tree honours the commit's index, GIT_INDEX_FILE)
tree="$(git write-tree)" || exit 1
. "$(dirname "$0")/snapshot.sh" || exit 1
echo "harness: checking the staged snapshot only (HARNESS_HOOK_STAGED_ONLY=1)"
snapshot_check "$tree" check-fast merge
