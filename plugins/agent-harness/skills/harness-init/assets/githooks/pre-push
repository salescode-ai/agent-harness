#!/usr/bin/env bash
# agent-harness git hook: runs the repo's check gate when the checked-out commit is pushed. Skips only while the gate
# isn't wired yet; a gate that can't be resolved (broken Makefile) fails the push. SKIP_HOOKS=1 skips it (people
# only: the Bash guard refuses it for agents). HARNESS_HOOK_STAGED_ONLY=1 checks the pushed commit alone, in a scratch
# worktree, when there is uncommitted code.
[ "${SKIP_HOOKS:-}" = 1 ] && { echo "harness: SKIP_HOOKS=1, skipping pre-push"; exit 0; }
# harness-init writes .harness/init-state.json first and sets "gate_wired": true last; skip until then
if [ -f .harness/init-state.json ] && ! grep -qE '"gate_wired"[[:space:]]*:[[:space:]]*true' .harness/init-state.json; then
  echo "harness: setup in progress, skipping"; exit 0
fi
# git passes "<local ref> <local sha> <remote ref> <remote sha>" per pushed ref. check tests the working tree, so it
# runs only when one of them is HEAD; tags, deletions (local sha all zeros) and other branches are skipped.
if [ ! -t 0 ]; then
  head="$(git rev-parse -q --verify HEAD)"; refs=0; mine=0
  while read -r -t 5 lref lsha rref rsha; do  # -t: an inherited stdin that never closes (a manual run) is not git
    [ -n "$lref" ] || continue
    refs=$((refs+1))
    case "$lsha" in *[!0]*) ;; *) continue;; esac
    case "$lref" in refs/tags/*) continue;; esac
    [ "$lsha" = "$head" ] && mine=1
  done
  if [ $refs -gt 0 ] && [ $mine = 0 ]; then
    echo "harness: no pushed ref is the checked-out HEAD (tags, deletions or another branch), skipping check"; exit 0
  fi
fi
[ -f scripts/harness/cmd.sh ] || { echo "harness: scripts/harness/cmd.sh missing, skipping"; exit 0; }
cmd="$(bash scripts/harness/cmd.sh . check)"; rc=$?
if [ $rc != 0 ]; then
  # nothing to resolve the gate from, and init never wired it: not set up yet
  if [ $rc = 3 ] && ! grep -qs '"gate_wired"[[:space:]]*:[[:space:]]*true' .harness/init-state.json \
    && [ ! -f Makefile ] && [ ! -f makefile ] && [ ! -f GNUmakefile ] && [ ! -f .agents/harness.json ]; then
    echo "harness: check not wired, skipping"; exit 0
  fi
  echo "harness: cannot resolve the check gate (scripts/harness/cmd.sh exit $rc):" >&2
  make -n check 2>&1 >/dev/null | tail -5 | sed 's/^/  /' >&2
  echo "  Run make -n check and fix the Makefile (or .agents/harness.json)." >&2
  exit 1
fi
# uncommitted code is part of an in-place check (said so); HARNESS_HOOK_STAGED_ONLY=1 checks exactly the pushed commit
# in a scratch worktree instead, opt-in because gitignored inputs (local config, generated code, caches) aren't there
dirty="$( { git diff --name-only HEAD; git ls-files --others --exclude-standard; } 2>/dev/null | grep -vE '^docs/|\.md$' | sort -u)"
h="$(git rev-parse --short HEAD 2>/dev/null)"
if [ -z "$dirty" ]; then echo "harness: checking the pushed commit $h in place (clean tree)"; eval "$cmd"; exit; fi
if [ "${HARNESS_HOOK_STAGED_ONLY:-}" != 1 ]; then
  echo "harness: uncommitted changes are part of this check ($(head -3 <<<"$dirty" | tr '\n' ' ' | sed 's/ $//')); HARNESS_HOOK_STAGED_ONLY=1 checks only the pushed commit $h" >&2
  eval "$cmd"; exit
fi
[ -f "$(dirname "$0")/snapshot.sh" ] || {
  echo "harness: .githooks/snapshot.sh missing (run /agent-harness:harness-upgrade); checking in place" >&2; eval "$cmd"; exit; }
. "$(dirname "$0")/snapshot.sh" || exit 1
echo "harness: uncommitted changes ($(head -3 <<<"$dirty" | tr '\n' ' ' | sed 's/ $//')); checking the pushed commit $h in a scratch worktree"
snapshot_check HEAD check
