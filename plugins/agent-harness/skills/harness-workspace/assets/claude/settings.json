{
  "extraKnownMarketplaces": {
    "agent-harness": { "source": { "source": "github", "repo": "<your-org>/agent-harness" } }
  },
  "enabledPlugins": {
    "agent-harness@agent-harness": true
  },
  "permissions": {
    "deny": ["Read(./**/.env)", "Read(./**/.env.local)", "Read(./**/.env.*.local)", "Read(./**/.env.prod*)", "Read(./**/.env.staging*)", "Read(./**/secrets/**)", "Read(./**/*.pem)", "Read(./**/*.key)"]
  }
}
